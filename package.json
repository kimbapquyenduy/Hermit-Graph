{
  "name": "hermit-graph",
  "version": "7.1.0",
  "description": "Persistent memory for AI coding agents. Knowledge graph with 4-tier taxonomy, confidence scoring, and MCP protocol support for Claude Code, Cursor, Gemini CLI, Windsurf, Cline, Codex, and OpenCode.",
  "type": "module",
  "bin": {
    "hermit": "./scripts/brain-cli.mjs",
    "hermit-migrate": "./scripts/migrate-jsonl-to-sqlite.mjs",
    "hermit-migrate-vec": "./scripts/migrate-embeddings-to-vec.mjs",
    "hermit-verify": "./scripts/verify-parity.mjs",
    "hermit-export-jsonl": "./scripts/export-sqlite-to-jsonl.mjs",
    "hermit-export": "./scripts/export-sqlite-to-jsonl.mjs"
  },
  "files": [
    "scripts/lib/",
    "scripts/brain-cli.mjs",
    "scripts/brain-health.mjs",
    "scripts/build-embedding-index.mjs",
    "scripts/clean-skills.mjs",
    "scripts/export-sqlite-to-jsonl.mjs",
    "scripts/migrate-jsonl-to-sqlite.mjs",
    "scripts/migrate-embeddings-to-vec.mjs",
    "scripts/verify-parity.mjs",
    "scripts/hermit-mcp-server.mjs",
    "scripts/merge-brain-jsonl.mjs",
    "scripts/migrate-v3-to-v4.mjs",
    "scripts/setup-conventions.mjs",
    "scripts/setup-project.mjs",
    "scripts/setup-semantic.mjs",
    "scripts/skills-manager.mjs",
    "scripts/stale-report.mjs",
    "scripts/backfill-confidence.mjs",
    "scripts/view-graph.mjs",
    "scripts/check-edit-cli.mjs",
    "catalog/",
    "templates/",
    "viewer/index.html",
    "viewer/code-viewer.html",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "memory",
    "knowledge-graph",
    "mcp",
    "claude",
    "claude-code",
    "cursor",
    "gemini",
    "gemini-cli",
    "windsurf",
    "cline",
    "codex",
    "opencode",
    "coding-agent",
    "persistent-memory",
    "brain",
    "ast-grep",
    "code-intelligence",
    "mcp-server",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kimbapquyenduy/hermit-graph.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node scripts/hermit-mcp-server.mjs",
    "test": "node scripts/test-v4.mjs",
    "setup": "node scripts/setup-project.mjs",
    "health": "node scripts/brain-health.mjs",
    "migrate": "node scripts/migrate-v3-to-v4.mjs",
    "backfill": "node scripts/backfill-confidence.mjs",
    "stale": "node scripts/stale-report.mjs",
    "export": "node scripts/export-sqlite-to-jsonl.mjs",
    "sync": "node scripts/sync-to-neo4j.mjs",
    "view": "node scripts/view-graph.mjs",
    "view:code": "node scripts/view-graph.mjs --code",
    "view:live": "node scripts/export-sqlite-to-jsonl.mjs && node scripts/view-graph.mjs",
    "setup:semantic": "node scripts/setup-semantic.mjs",
    "setup:conventions": "node scripts/setup-conventions.mjs",
    "setup:all": "node scripts/setup-project.mjs && node scripts/setup-semantic.mjs && node scripts/setup-conventions.mjs",
    "build:index": "node scripts/build-embedding-index.mjs",
    "build:index:force": "node scripts/build-embedding-index.mjs --force",
    "prepublishOnly": "node scripts/publish-preflight.mjs",
    "test:e2e": "node scripts/test-e2e-code-intel.mjs",
    "test:all": "node scripts/test-v4.mjs && node scripts/test-e2e-code-intel.mjs",
    "bench:tokens": "node scripts/bench/run-token-bench.mjs",
    "bench:hard": "node scripts/bench/run-hard-bench.mjs",
    "bench:functional": "node scripts/bench/run-functional-bench.mjs",
    "bench:framework-e2e": "node scripts/bench/run-framework-e2e.mjs",
    "publish:dry": "npm pack --dry-run",
    "smoke:vec": "node scripts/smoke-sqlite-vec.mjs"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.42.1",
    "@huggingface/transformers": "^4.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "fast-xml-parser": "^5.7.1"
  }
}
