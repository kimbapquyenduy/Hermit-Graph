{
  "name": "hermit-graph",
  "version": "8.0.0-dev.0",
  "description": "Persistent memory for AI coding agents. Knowledge graph with 4-tier taxonomy, confidence scoring, and MCP protocol support for Claude Code, Cursor, Gemini CLI, Windsurf, Cline, Codex, and OpenCode.",
  "type": "module",
  "bin": {
    "hermit": "./scripts/brain-cli.mjs"
  },
  "files": [
    "scripts/lib/",
    "scripts/brain-cli.mjs",
    "scripts/brain-health.mjs",
    "scripts/hermit-mcp-server.mjs",
    "scripts/skills-manager.mjs",
    "scripts/view-graph.mjs",
    "scripts/check-edit-cli.mjs",
    "catalog/",
    "templates/",
    "viewer/index.html",
    "viewer/code-viewer.html",
    "README.md",
    "LICENSE",
    "scripts/hermit-mcp-v8.mjs",
    "scripts/doctor.mjs",
    "scripts/backup-brain.mjs",
    "scripts/semantic-cli.mjs",
    "scripts/hermit-hook.mjs",
    "scripts/verify-hook-scanner-authority.mjs",
    "scripts/setup-v8.mjs",
    "scripts/maintenance-cli.mjs",
    "scripts/diagnostics-cli.mjs",
    "scripts/scan-cli.mjs",
    "scripts/memory-cli.mjs",
    "scripts/code-index-cli.mjs"
  ],
  "keywords": [
    "ai",
    "memory",
    "knowledge-graph",
    "mcp",
    "claude",
    "claude-code",
    "cursor",
    "gemini",
    "gemini-cli",
    "windsurf",
    "cline",
    "codex",
    "opencode",
    "coding-agent",
    "persistent-memory",
    "brain",
    "ast-grep",
    "code-intelligence",
    "mcp-server",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kimbapquyenduy/hermit-graph.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "serve": "node scripts/hermit-mcp-server.mjs",
    "test": "node scripts/test-runner.mjs",
    "setup": "node scripts/setup-v8.mjs",
    "health": "node scripts/brain-health.mjs",
    "stale": "node scripts/memory-cli.mjs stale",
    "export": "node scripts/memory-cli.mjs export",
    "view": "node scripts/view-graph.mjs",
    "view:live": "node scripts/view-graph.mjs",
    "setup:all": "node scripts/setup-v8.mjs --agent all",
    "build:index": "node scripts/code-index-cli.mjs",
    "prepublishOnly": "node scripts/publish-preflight.mjs",
    "test:e2e": "node scripts/test-e2e-code-intel.mjs",
    "test:all": "npm test",
    "bench:tokens": "node scripts/bench/run-token-bench.mjs",
    "bench:hard": "node scripts/bench/run-hard-bench.mjs",
    "bench:functional": "node scripts/bench/run-functional-bench.mjs",
    "bench:framework-e2e": "node scripts/bench/run-framework-e2e.mjs",
    "publish:dry": "npm pack --dry-run",
    "smoke:vec": "node scripts/smoke-sqlite-vec.mjs",
    "doctor": "node scripts/brain-cli.mjs doctor",
    "test:v8": "node --test test/v8-*.test.mjs",
    "verify:hooks": "node scripts/verify-hook-scanner-authority.mjs",
    "verify:package": "node scripts/verify-v8-package.mjs",
    "bench:legacy": "node scripts/bench/legacy-reference.mjs",
    "bench:v8": "node scripts/bench/v8-runtime.mjs"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.42.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.0",
    "graphology": "0.25.4",
    "jsonc-parser": "^3.3.1",
    "sigma": "2.4.0",
    "smol-toml": "^1.8.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "fast-xml-parser": "^5.7.1",
    "@huggingface/transformers": "^4.0.1"
  },
  "devDependencies": {
    "better-sqlite3": "^12.9.0",
    "sqlite-vec": "^0.1.9"
  }
}
